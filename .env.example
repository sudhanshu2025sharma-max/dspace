G# ==============================================================================
# DSPACE JUBILEE CONFERENCE - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================
# Copy this file to '.env.local' for local development.
# In Vercel, add these same variables under:
# Project Settings -> Environment Variables.
#
# SECURITY NOTICE:
# - Do NOT use your regular Google account password.
# - Generate a 16-character dedicated Google App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Ensure 2-Step Verification is turned ON.
#   3. Go to "App passwords" (or search "App passwords" in Google Account).
#   4. Create a new app password named "DSpace Conference Poster Portal".
#   5. Copy the 16-letter code without spaces into GMAIL_APP_PASSWORD below.
# - These variables will ONLY be accessed server-side (Node.js runtime on Vercel)
#   and will NEVER be sent to the browser / client bundle.
# ==============================================================================

# Gmail address used to send notifications and confirmations
GMAIL_USER=your-conference-email@gmail.com

# 16-character Google App Password (without spaces)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Admin email where poster submissions will be forwarded
ADMIN_EMAIL=admin-conference@your-institution.edu

# Optional conference notification sender name
CONFERENCE_NAME="DSpace Jubilee International Conference"
